{
  // pa-policy-extractor — Cloudflare Worker fronting a Cloudflare Container.
  "name": "pa-policy-extractor",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",

  // Keep the Worker OFF its public *.workers.dev hostname. Access is enforced at
  // the edge on the operator's custom domain (attached in the Cloudflare
  // dashboard, not in this file); an Access application is bound to a HOSTNAME,
  // so a live workers.dev hostname is a second front door that the policy does
  // not cover.
  //
  // This is declared here rather than toggled in the dashboard because a toggle
  // does not survive: the subdomain was disabled on 2026-08-02, and the very
  // next `wrangler deploy` turned it back on (verified — enabled flipped
  // false -> true across the deploy). Omitting this field lets every deploy
  // re-open the hostname silently. See docs/CONTAINERS-OFFLINE.md §3 item 5.
  "workers_dev": false,

  // ─── CONTAINER DISABLED, 2 AUGUST 2026 ───────────────────────────────────
  //
  // The container application `pa-policy-extractor-pacontainer` (version 15)
  // was DELETED because it billed wall-clock time in an idle, self-rearming
  // Durable Object alarm loop: 180,004 ms of wall time against 0 ms of CPU,
  // over and over, while serving no traffic (exactly one inbound request in
  // the preceding week, a verified OAI-SearchBot crawl of /robots.txt). It was
  // running 3 instances at standard-4 — 12 vCPU and 36 GiB standing — for
  // nothing.
  //
  // This block stays COMMENTED OUT so a `wrangler deploy` from CI cannot
  // silently resurrect that fleet. Uncommenting it re-creates the container
  // application on the next deploy, and re-creates the bill, because the alarm
  // loop is a property of the deployed code and is NOT fixed yet.
  //
  // Note what is deliberately NOT removed: the PaContainer Durable Object
  // binding, its `v1` migration tag and its class export all remain below, so
  // the Worker still typechecks and deploys. Every route that would reach the
  // container short-circuits on CONTAINERS_OFFLINE (src/util.ts) and answers a
  // 503 with a human sentence.
  //
  // ROOT CAUSE, THE EXACT DELETED CONFIG, RESTORE STEPS AND THE
  // FIX-BEFORE-RESTORING LIST:  docs/CONTAINERS-OFFLINE.md
  //
  // "containers": [
  //   {
  //     "class_name": "PaContainer",
  //     "image": "./container/Dockerfile",
  //     "image_build_context": "./container",
  //     // standard-4 = 4 vCPU / 12 GiB / 20 GB disk — chosen for CPU OCR
  //     // headroom, and the largest instance type this account allows.
  //     "instance_type": "standard-4",
  //     // Sticky-per-PDF routing fans distinct PDFs out across instances;
  //     // capped at 3 to bound worst-case concurrent containers (cost).
  //     // NOTE: 3 is a leftover from batch concurrency and should come back as
  //     // 1 — see the fix list. Lowering it would NOT have fixed the bill; it
  //     // would have divided it by three and left the loop running forever.
  //     "max_instances": 3,
  //     // Single-step rollouts: the default staged rollout ([10, 100]) left the
  //     // OLD image serving most new instance starts for an indeterminate
  //     // window after a successful deploy — observed live: a fixed image
  //     // deployed green while fresh boots still ran the broken one. A
  //     // 3-instance demo app gets no canary value from staging (Worker +
  //     // container ship together), and automated post-deploy testing needs
  //     // "deploy finished" to mean "new image serving". 100 = every instance
  //     // updates in one step.
  //     "rollout_step_percentage": 100
  //   }
  // ],

  // Durable Object bindings:
  //   PA_CONTAINER    — the Worker's handle to the container class.
  //   RATE_LIMITER    — the per-IP sliding-window rate limiter DO.
  //   JOB_COORDINATOR — the per-job async/batch coordinator DO (Layer 3).
  "durable_objects": {
    "bindings": [
      { "name": "PA_CONTAINER", "class_name": "PaContainer" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
      { "name": "JOB_COORDINATOR", "class_name": "JobCoordinator" }
    ]
  },

  // Durable Object migrations. v1 registered the container class; v2 added the
  // SQLite-backed RateLimiter; v3 adds the SQLite-backed JobCoordinator. Each is
  // a NEW tag — existing v1/v2 tags are untouched so deployed state is preserved.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PaContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["RateLimiter"] },
    { "tag": "v3", "new_sqlite_classes": ["JobCoordinator"] }
  ],

  // R2 bucket for Layer 3: staged uploads (pdfs/<jobId>/<i>.pdf) and finished
  // aggregated results (results/<jobId>.json). The JobCoordinator writes/reads
  // here; the retention alarm deletes per-job objects after RETENTION_DAYS.
  // ALSO holds the persistent-library full result JSON (results/lib/<id>.json),
  // whose lean index lives in the LIBRARY D1 database below.
  //
  // KNOWLEDGE_BUCKET ("pa-knowledge"; create it before the first deploy, see
  // OPERATOR SETUP below) backs the ADVISORY
  // "Ask" feature: every saved analysis and every web-check verdict ALSO writes
  // a markdown digest to knowledge/<owner>/<sha>-<brand>[-webcheck].md (the
  // owner path segment is the tenancy boundary AI Search folder filters scope
  // on). Digest writes are best-effort by contract — a failure never breaks
  // the analysis/library/webcheck flows.
  "r2_buckets": [
    { "binding": "RESULT_BUCKET", "bucket_name": "pa-job-results" },
    { "binding": "KNOWLEDGE_BUCKET", "bucket_name": "pa-knowledge" }
  ],

  // Workers AI binding — used ONLY by the advisory "Ask" feature (POST
  // /api/ask) to reach AI Search via env.AI.autorag(AISEARCH_NAME).aiSearch().
  // The AI Search instance itself is created in the DASHBOARD (AI > AI Search)
  // over the pa-knowledge bucket and referenced BY NAME at call time, so
  // nothing here points at it: an absent/misnamed instance degrades /api/ask
  // to a clean 503 and never breaks the analysis flows. NOTE: do NOT set
  // `remote` here — wrangler hard-errors on `remote: false` (AI has no local
  // simulator) and `remote: true` would make the vitest pool demand an
  // authenticated remote proxy session; left unset, local dev/tests get a
  // stub whose calls fail (the asserted 503 path) with only a wrangler
  // warning, and production always binds the real service.
  "ai": { "binding": "AI" },

  // D1 database backing the persistent, queryable analysis library (table
  // `analyses`). The schema is applied LAZILY at runtime via CREATE TABLE IF NOT
  // EXISTS (see src/library.ts → ensureLibrarySchema), so there is NO local
  // `wrangler d1 migrations` step.
  //
  // OPERATOR SETUP, before the first deploy: create the "pa-library" D1 database
  // and the "pa-job-results" and "pa-knowledge" R2 buckets in YOUR Cloudflare
  // account (dashboard, or `wrangler d1 create pa-library` and
  // `wrangler r2 bucket create <name>`). The deploy fails if any is missing.
  //
  // `database_id` below is a PLACEHOLDER (all zeros). Supply the real id in one
  // of two ways:
  //   * CI deploys (.github/workflows/deploy.yml): leave the zeros and store the
  //     id as the GitHub Actions secret PA_LIBRARY_DATABASE_ID. The deploy job
  //     writes it in just before `wrangler deploy` and stops with an error if
  //     the secret is missing or malformed.
  //   * Deploying by hand: replace the zeros with your database's id (and keep
  //     that edit out of any public repository).
  // Both D1 and R2 are on the Workers Paid included tiers, so this stays
  // subscription-bounded.
  "d1_databases": [
    {
      "binding": "LIBRARY",
      "database_name": "pa-library",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],

  // P0 "Live Web Check" — a Cloudflare Workflow (class re-exported from
  // src/index.ts, implementation in src/web-check.ts) running the ADVISORY
  // live-source cross-check: fetch the payer's policy page + the brand's FDA
  // label, ONE DeepSeek compare call, persist the verdict to R2
  // (webchecks/<sha>/<brand>.json). The Workflow gives each network-bound step
  // DURABLE retries (exponential backoff; progress survives restarts). The
  // payer page is fetched via the Browser Rendering REST API authenticated
  // with the CF_API_TOKEN secret — that token must ALSO carry the
  // "Browser Rendering: Edit" scope, else payer-page fetches degrade
  // gracefully (the FDA-label half of the check still runs). Advisory only:
  // a web check never touches analysis results.
  "workflows": [
    { "name": "web-check", "binding": "WEB_CHECK_WF", "class_name": "WebCheckWorkflow" }
  ],

  // Static UI in ./public. run_worker_first=true sends EVERY request through the
  // Worker first, so the Worker can wrap asset responses (the main HTML document,
  // app.js, theme.js, styles.css, favicon, SPA fallback) with the CSP + security
  // headers via env.ASSETS.fetch + withSecurityHeaders (src/index.ts). A
  // selective ["/api/*"] route would bypass the Worker for assets and ship the
  // document with NO Content-Security-Policy. SPA fallback to index.html is
  // still handled by the Assets server when the Worker calls env.ASSETS.fetch.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  // Plain (non-secret) vars forwarded into the container by the Worker.
  // DEEPSEEK_API_KEY, CF_AIG_TOKEN and CF_API_TOKEN are SECRETS — set via
  // `wrangler secret put` (or the dashboard), never committed here.
  "vars": {
    // Container kill switch (2026-08-02) — the runtime half of the commented-out
    // `containers` block above. While this is anything but an explicit "0", the
    // Worker refuses every container-backed route (/api/analyze, /api/extract,
    // /api/health, the /api/jobs staging + creation family, cohort runs, and the
    // daily cron's cohort re-runs) with a 503 and a human sentence, and never
    // constructs the PaContainer Durable Object. Absent ALSO means offline —
    // fail safe. Set to "0" only after the alarm loop in
    // docs/CONTAINERS-OFFLINE.md is fixed and the container application has been
    // redeployed.
    "CONTAINERS_OFFLINE": "1",

    // CF_AIG_ACCOUNT_ID: your Cloudflare account id. Used for the AI Gateway, and
    // ALSO required for the W3 multi-model consensus secondary base URL (Workers AI)
    // — not only the AI Gateway. Leave "" to disable both. With BOTH set, the
    // DeepSeek primary AND the Workers AI validators route through the gateway
    // named in CF_AIG_GATEWAY_ID (change it to your own gateway's id), so its
    // budget/spend cap governs all LLM traffic.
    //
    // The value committed here is a PLACEHOLDER. CI deploys replace it with the
    // CLOUDFLARE_ACCOUNT_ID GitHub Actions secret (the account the Worker is
    // deployed into) just before `wrangler deploy`. Deploying by hand: put your
    // account id here, or "" to disable the gateway and the validators.
    "CF_AIG_ACCOUNT_ID": "<your-cloudflare-account-id>",
    "CF_AIG_GATEWAY_ID": "firstgateway",
    "DEEPSEEK_MODEL": "deepseek-v4-pro",
    "DEEPSEEK_THINKING": "on",
    "DEEPSEEK_REASONING_EFFORT": "high",

    // W3 (optional multi-model consensus) — the legacy SECONDARY cross-check
    // model id, used ONLY when VALIDATOR_MODELS is unset (it isn't — see below),
    // so this is inert today. Kept for backward compat; matches the first
    // VALIDATOR_MODELS entry. Its account token CF_API_TOKEN is a dashboard
    // SECRET (NOT a var here); consensus no-ops when CF_API_TOKEN is absent.
    "SECONDARY_MODEL": "@cf/openai/gpt-oss-20b",

    // W3-ext (3-model consensus) — the LIST of Workers AI VALIDATOR models (CSV
    // of @cf/ ids) the container runs alongside canonical DeepSeek when a request
    // opts into consensus ("consensus" form field; off by default). Each
    // validator reuses CF_API_TOKEN (dashboard SECRET) + CF_AIG_ACCOUNT_ID.
    // Degrades gracefully (fewer/no validators) if the token is unset or a
    // validator errors. Supported on BOTH the interactive and batch paths (the
    // JobCoordinator forwards the job's `consensus` flag per PDF).
    // Model choice (researched 2026-06): both have 128k context on Workers AI
    // (policy docs reach ~75k tokens; Workers AI HARD-ERRORS on oversized input)
    // and top-tier JSON-mode reliability. The previous defaults were unfit:
    // llama-3.3-70b-fp8-fast is 24k-ctx on Workers AI and gemma-3-12b was
    // deprecated 2026-05-30. Cheap fallback (small docs only, 32.7k ctx):
    // @cf/qwen/qwen3-30b-a3b-fp8.
    "VALIDATOR_MODELS": "@cf/openai/gpt-oss-20b,@cf/mistralai/mistral-small-3.1-24b-instruct",

    // #4 (deploy): the documented, configurable per-PDF LLM-call budget. Forwarded
    // to the container (container/app.py reads MAX_LLM_CALLS) AND mirrored by the
    // Worker's up-front job budget check so a job is rejected before staging work.
    // 200 fits the worst legal request: 15 brands × (2×3 deep runs + 1 spans +
    // 2 validators × 3 runs) = 195 calls.
    "MAX_LLM_CALLS": "200",

    // Accuracy-pipeline tunables (forwarded to the container; defaults match the
    // in-code constants). CONFIDENCE_RUNS: applies when `runs` is omitted — kept
    // at "1" so interactive uploads stay fast/cheap (the UI's Deep-Confidence
    // toggle sends runs=3 explicitly; batch jobs also send runs explicitly).
    // REDUCER_PASSTHROUGH_CHARS / SCORING_MAX_CHARS: override-layer thresholds
    // (reducer passthrough gate; scoring+validator input cap matching the
    // validated original's scoring loop). PRIMARY_MAX_CHARS: the larger guard
    // for the primary model's extraction/spans inputs — small/medium documents
    // go to the model whole; beyond the cap, huge payer documents are
    // brand-aware window packed (head + criteria modules), never blind
    // head-truncated. Deliberately below DeepSeek v4-pro's 1M-token window:
    // measured live, ~180k-token calls ran 10+ minutes each (prefill), so
    // maximal-context inputs are operationally untenable for interactive use.
    "CONFIDENCE_RUNS": "1",
    "REDUCER_PASSTHROUGH_CHARS": "100000",
    "SCORING_MAX_CHARS": "300000",
    "PRIMARY_MAX_CHARS": "600000",

    // Layer 3 (async/batch jobs) — subscription-bounded caps:
    //   MAX_PDFS_PER_JOB    — hard cap on PDFs per job.
    //   MAX_CONCURRENT_PDFS — in-flight PDFs per job (<= container max_instances=3).
    //   RETENTION_DAYS      — auto-delete a job's R2 objects + DO storage after N days.
    "MAX_PDFS_PER_JOB": "25",
    "MAX_CONCURRENT_PDFS": "2",
    "RETENTION_DAYS": "7",

    // #3 (cost): persistent-library retention. The daily scheduled() cron prunes
    // `analyses` rows (and their R2 results/lib/<id>.json) older than this many
    // days, bounded per run, so the library cannot grow unbounded. Default 30.
    "LIBRARY_RETENTION_DAYS": "30",

    // "Ask" (advisory Q&A over the collected knowledge): the NAME of the AI
    // Search instance POST /api/ask queries. OPERATOR SETUP: create it in the
    // dashboard (AI > AI Search) with this exact name, pointed at the
    // pa-knowledge R2 bucket (KNOWLEDGE_BUCKET above); it then continuously
    // indexes the digests the Worker writes. Until it exists (or if the name
    // here doesn't match), /api/ask answers a clean 503 — the digest writes and
    // every analysis/library/webcheck flow keep working unchanged.
    "AISEARCH_NAME": "pa-knowledge"

    // Opt-in tenant isolation (security fix #2) — UNSET by default. To verify
    // identity via signed Cloudflare Access JWTs instead of trusting the
    // spoofable cf-access-authenticated-user-email header, set BOTH of these
    // (then a missing/invalid Cf-Access-Jwt-Assertion is rejected with 401):
    //   "ACCESS_TEAM_DOMAIN": "<team>.cloudflareaccess.com",
    //   "ACCESS_AUD": "<your Access Application AUD tag>"
    // While unset, tenant isolation REQUIRES Cloudflare Access enforcement on the
    // route (otherwise the identity header is spoofable).
  },

  // Daily maintenance plus W5 scheduled cohorts. The Worker's scheduled()
  // handler prunes expired library rows, sweeps expired staged-upload markers
  // and their deterministic PDF objects, then re-runs ONLY cohorts that opted
  // in (schedule_enabled=1). With nothing to prune, sweep, or re-run it performs
  // bounded D1/R2 checks and wakes no container. Each scheduled cohort that
  // DOES run stages its PDFs into a new batch job and costs the same as a manual
  // "Run now", which is why the per-cohort toggle is OFF by default.
  // Cron runs at 06:00 UTC daily.
  "triggers": {
    "crons": ["0 6 * * *"]
  },

  "observability": { "enabled": true }
}
