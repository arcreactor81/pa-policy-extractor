{
  // Type config for the Worker test suite. The `cloudflare:test` virtual module
  // and the `@cloudflare/vitest-pool-workers/config` entrypoint resolve under
  // vitest's loader at `npm test` time; this tsconfig gives editors/local tsc
  // the same types. It is intentionally NOT part of the deploy-gate typecheck
  // (tsconfig.json), which covers only the deployable src.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // The /types subpath carries the `cloudflare:test` module declarations
    // (the package's root types are the pool API, not the test globals).
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"]
  },
  // Override the inherited root exclude: the root tsconfig excludes "test" and
  // "vitest.config.mts" (so the deploy-gate typecheck skips them), but THIS
  // config exists to check exactly those test files — without this override,
  // `tsc -p test` passes vacuously on zero files. vitest.config.mts stays out:
  // its vitest/config import graph needs @types/node, which we don't ship; the
  // config file is execute-verified by `npm test` itself.
  "exclude": ["../node_modules"],
  "include": ["./**/*.ts", "../src/**/*.ts", "../worker-configuration.d.ts"]
}
